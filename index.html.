<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Period Group Sorter</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

  :root{
    --bg:#182922;
    --panel:#213730;
    --panel-raised:#294539;
    --chalk:#F2EFE4;
    --chalk-dim:#AFC2B7;
    --amber:#E8A33D;
    --amber-dim:#B77E2C;
    --teal:#6FA98C;
    --line: rgba(242,239,228,0.12);
    --danger:#D9695A;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--chalk);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding:28px 16px 60px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:760px;margin:0 auto;}

  .masthead{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom:22px; flex-wrap:wrap; gap:8px;
  }
  .masthead h1{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700; font-size:26px; letter-spacing:-0.01em;
    margin:0;
  }
  .masthead .sub{
    color:var(--chalk-dim); font-size:13px;
  }
  .save-indicator{
    font-size:12px; color:var(--teal); opacity:0; transition:opacity .4s ease;
    display:flex; align-items:center; gap:6px;
  }
  .save-indicator.show{opacity:1;}
  .save-indicator .dot{width:6px;height:6px;border-radius:50%;background:var(--teal);}

  .panels{display:flex; flex-direction:column; gap:10px;}

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    transition: box-shadow .3s ease;
  }
  .panel.active{
    box-shadow: 0 8px 30px rgba(0,0,0,0.35);
    border-color: rgba(232,163,61,0.35);
  }

  .panel-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 18px;
    cursor:pointer;
    user-select:none;
    -webkit-tap-highlight-color:transparent;
  }
  .panel-head:hover{background:rgba(255,255,255,0.02);}

  .head-left{display:flex; align-items:center; gap:12px;}
  .period-badge{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700; font-size:16px;
    color:var(--bg);
    background:var(--amber);
    padding:4px 12px;
    border-radius:999px;
    letter-spacing:0.02em;
    transition: transform .25s ease;
  }
  .panel.active .period-badge{
    background:var(--chalk);
  }
  .roster-count{color:var(--chalk-dim); font-size:13px;}

  .chevron{
    width:20px; height:20px; color:var(--chalk-dim);
    transition: transform .3s ease;
    flex-shrink:0;
  }
  .panel.active .chevron{ transform:rotate(180deg); color:var(--amber); }

  .panel-body{
    max-height:0;
    opacity:0;
    transition: max-height .38s cubic-bezier(.4,0,.2,1), opacity .28s ease, padding .3s ease;
    padding:0 18px;
  }
  .panel.active .panel-body{
    max-height:900px;
    opacity:1;
    padding:0 18px 20px;
  }

  .body-grid{
    display:grid;
    grid-template-columns: 1.1fr 1fr;
    gap:18px;
    padding-top:4px;
  }
  @media (max-width:560px){
    .body-grid{grid-template-columns:1fr;}
  }

  label.field-label{
    display:block; font-size:11px; text-transform:uppercase; letter-spacing:.08em;
    color:var(--chalk-dim); margin-bottom:6px; font-weight:600;
  }

  textarea.roster-input{
    width:100%;
    min-height:180px;
    resize:vertical;
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:10px;
    color:var(--chalk);
    font-family:'Inter',monospace;
    font-size:14px;
    line-height:1.6;
    padding:10px 12px;
    outline:none;
  }
  textarea.roster-input:focus{border-color:var(--amber-dim);}

  .controls{display:flex; flex-direction:column; gap:14px;}

  .group-mode{
    display:flex; gap:6px;
    background:var(--bg);
    border-radius:10px; padding:4px; border:1px solid var(--line);
  }
  .group-mode button{
    flex:1; background:transparent; border:none; color:var(--chalk-dim);
    padding:8px 6px; border-radius:7px; font-size:12.5px; font-weight:600;
    cursor:pointer; font-family:'Inter',sans-serif;
  }
  .group-mode button.on{ background:var(--panel-raised); color:var(--chalk); }

  .num-stepper{
    display:flex; align-items:center; gap:10px;
  }
  .num-stepper button{
    width:32px; height:32px; border-radius:8px; border:1px solid var(--line);
    background:var(--panel-raised); color:var(--chalk); font-size:16px; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .num-stepper .val{
    font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:18px;
    min-width:24px; text-align:center;
  }

  .spin-btn{
    margin-top:4px;
    background:var(--amber);
    color:var(--bg);
    border:none;
    font-family:'Space Grotesk',sans-serif;
    font-weight:700; font-size:15px;
    padding:12px 16px;
    border-radius:10px;
    cursor:pointer;
    transition: transform .12s ease, background .2s ease;
  }
  .spin-btn:hover{background:#f0b25c;}
  .spin-btn:active{transform:scale(0.97);}
  .spin-btn:disabled{opacity:.5; cursor:default;}
  .spin-btn.spinning{background:var(--teal);}

  .empty-hint{
    color:var(--chalk-dim); font-size:12.5px; margin-top:4px;
  }

  .results{
    margin-top:16px;
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(150px,1fr));
    gap:10px;
  }
  .group-card{
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:10px;
    padding:12px 14px;
    opacity:0;
    transform:translateY(6px);
    animation: settle .4s ease forwards;
  }
  @keyframes settle{ to{opacity:1; transform:translateY(0);} }
  .group-card h4{
    margin:0 0 8px; font-family:'Space Grotesk',sans-serif;
    font-size:12px; letter-spacing:.06em; text-transform:uppercase;
    color:var(--teal);
  }
  .group-card ul{margin:0; padding:0; list-style:none;}
  .group-card li{
    font-size:14.5px; padding:3px 0; color:var(--chalk);
    border-top:1px dashed rgba(242,239,228,0.08);
  }
  .group-card li:first-child{border-top:none;}

  .shuffle-strip{
    margin-top:16px;
    height:44px;
    display:flex; align-items:center;
    overflow:hidden;
    border-radius:10px;
    background:var(--bg);
    border:1px solid var(--line);
    position:relative;
  }
  .shuffle-strip .track{
    display:flex; gap:26px; padding-left:14px;
    white-space:nowrap;
    animation: scroll-left 0.5s linear infinite;
    font-family:'Space Grotesk',sans-serif;
    font-weight:600; color:var(--chalk-dim); font-size:14px;
  }
  @keyframes scroll-left{
    from{ transform:translateX(0); }
    to{ transform:translateX(-160px); }
  }

  footer{
    text-align:center; color:var(--chalk-dim); font-size:11.5px; margin-top:26px;
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="masthead">
    <div>
      <h1>Group Sorter</h1>
      <div class="sub">Tap a period to open it &middot; rosters save automatically</div>
    </div>
    <div class="save-indicator" id="saveIndicator"><span class="dot"></span><span id="saveText">Saved</span></div>
  </div>

  <div class="panels" id="panels"></div>

  <footer>Making Thinklings &middot; rosters are stored privately in this artifact</footer>
</div>

<script>
const PERIODS = ["P.1","P.2","P.3","P.4","P.5","P.6","P.7","P.8"];
const state = {}; // { "P.2": {roster:[], mode:'count'|'size', num:4, results:null} }
let activePeriod = null;
let saveTimers = {};

function storageKey(period){ return "roster:" + period; }
function settingsKey(period){ return "settings:" + period; }

async function loadAll(){
  for(const p of PERIODS){
    let roster = [];
    let settings = { mode:'count', num:4 };
    try{
      const raw = localStorage.getItem(storageKey(p));
      if(raw){ roster = JSON.parse(raw); }
    }catch(e){ /* no saved roster yet */ }
    try{
      const raw = localStorage.getItem(settingsKey(p));
      if(raw){ settings = JSON.parse(raw); }
    }catch(e){ /* defaults */ }
    state[p] = { roster, mode: settings.mode, num: settings.num, results:null };
  }
  activePeriod = PERIODS[0];
  render();
}

function showSaved(){
  const el = document.getElementById('saveIndicator');
  const txt = document.getElementById('saveText');
  txt.textContent = "Saved";
  el.classList.add('show');
  clearTimeout(showSaved._t);
  showSaved._t = setTimeout(()=> el.classList.remove('show'), 1400);
}

function showSaving(){
  const el = document.getElementById('saveIndicator');
  const txt = document.getElementById('saveText');
  txt.textContent = "Saving…";
  el.classList.add('show');
}

function queueSaveRoster(period, names){
  clearTimeout(saveTimers[period]);
  showSaving();
  saveTimers[period] = setTimeout(()=>{
    try{
      localStorage.setItem(storageKey(period), JSON.stringify(names));
      showSaved();
    }catch(e){ console.error("save failed", e); }
  }, 500);
}

function saveSettings(period){
  const s = state[period];
  try{
    localStorage.setItem(settingsKey(period), JSON.stringify({mode:s.mode, num:s.num}));
  }catch(e){ console.error("settings save failed", e); }
}

function parseRoster(text){
  return text.split("\n").map(s=>s.trim()).filter(Boolean);
}

function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    [a[i],a[j]] = [a[j],a[i]];
  }
  return a;
}

function buildGroups(names, mode, num){
  const shuffled = shuffle(names);
  let groups = [];
  if(mode === 'count'){
    const groupCount = Math.max(1, Math.min(num, shuffled.length || 1));
    groups = Array.from({length:groupCount}, ()=>[]);
    shuffled.forEach((name,i)=> groups[i % groupCount].push(name));
  } else {
    const size = Math.max(1, num);
    for(let i=0;i<shuffled.length;i+=size){
      groups.push(shuffled.slice(i, i+size));
    }
    if(groups.length === 0) groups = [[]];
  }
  return groups;
}

function render(){
  const panelsEl = document.getElementById('panels');
  panelsEl.innerHTML = "";
  PERIODS.forEach(period=>{
    const s = state[period];
    const isActive = period === activePeriod;

    const panel = document.createElement('div');
    panel.className = 'panel' + (isActive ? ' active' : '');

    const head = document.createElement('div');
    head.className = 'panel-head';
    head.innerHTML = `
      <div class="head-left">
        <span class="period-badge">${period}</span>
        <span class="roster-count">${s.roster.length} student${s.roster.length===1?'':'s'}</span>
      </div>
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    `;
    head.addEventListener('click', ()=>{
      activePeriod = isActive ? null : period;
      render();
    });
    panel.appendChild(head);

    const body = document.createElement('div');
    body.className = 'panel-body';

    if(isActive){
      body.innerHTML = `
        <div class="body-grid">
          <div>
            <label class="field-label">Roster (one name per line)</label>
            <textarea class="roster-input" placeholder="Add names here, one per line…">${s.roster.join("\n")}</textarea>
          </div>
          <div class="controls">
            <div>
              <label class="field-label">Split by</label>
              <div class="group-mode">
                <button data-mode="count" class="${s.mode==='count'?'on':''}">Number of groups</button>
                <button data-mode="size" class="${s.mode==='size'?'on':''}">Students per group</button>
              </div>
            </div>
            <div>
              <label class="field-label">${s.mode==='count' ? 'Groups' : 'Group size'}</label>
              <div class="num-stepper">
                <button data-step="-1">−</button>
                <span class="val">${s.num}</span>
                <button data-step="1">+</button>
              </div>
            </div>
            <button class="spin-btn">Generate groups</button>
            ${s.roster.length===0 ? '<div class="empty-hint">Add a roster above to generate groups.</div>' : ''}
          </div>
        </div>
        <div class="shuffle-zone"></div>
        <div class="results-zone"></div>
      `;
    }

    panel.appendChild(body);
    panelsEl.appendChild(panel);

    if(isActive){
      const textarea = body.querySelector('.roster-input');
      textarea.addEventListener('input', (e)=>{
        const names = parseRoster(e.target.value);
        state[period].roster = names;
        queueSaveRoster(period, names);
        const countEl = head.querySelector('.roster-count');
        countEl.textContent = `${names.length} student${names.length===1?'':'s'}`;
        const btn = body.querySelector('.spin-btn');
        if(btn) btn.disabled = names.length === 0;
      });

      body.querySelectorAll('.group-mode button').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          state[period].mode = btn.dataset.mode;
          saveSettings(period);
          render();
        });
      });

      body.querySelectorAll('.num-stepper button').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const delta = parseInt(btn.dataset.step,10);
          state[period].num = Math.max(1, state[period].num + delta);
          saveSettings(period);
          render();
        });
      });

      const spinBtn = body.querySelector('.spin-btn');
      if(spinBtn){
        spinBtn.disabled = s.roster.length === 0;
        spinBtn.addEventListener('click', ()=> runSpin(period, body));
      }

      if(s.results){
        renderResults(period, body, s.results);
      }
    }
  });
}

function runSpin(period, body){
  const s = state[period];
  if(s.roster.length === 0) return;

  const spinBtn = body.querySelector('.spin-btn');
  const shuffleZone = body.querySelector('.shuffle-zone');
  const resultsZone = body.querySelector('.results-zone');

  spinBtn.disabled = true;
  spinBtn.classList.add('spinning');
  spinBtn.textContent = 'Shuffling…';
  if(resultsZone) resultsZone.innerHTML = '';

  const namesLoop = shuffle(s.roster).concat(shuffle(s.roster)).concat(shuffle(s.roster));
  if(shuffleZone){
    shuffleZone.innerHTML = `<div class="shuffle-strip"><div class="track">${namesLoop.map(n=>`<span>${escapeHtml(n)}</span>`).join('')}</div></div>`;
  }

  setTimeout(()=>{
    const groups = buildGroups(s.roster, s.mode, s.num);
    state[period].results = groups;
    if(shuffleZone) shuffleZone.innerHTML = '';
    spinBtn.disabled = false;
    spinBtn.classList.remove('spinning');
    spinBtn.textContent = 'Generate groups';
    renderResults(period, body, groups);
  }, 900);
}

function renderResults(period, body, groups){
  const resultsZone = body.querySelector('.results-zone');
  if(!resultsZone) return;
  resultsZone.innerHTML = `<div class="results">${
    groups.map((g,i)=>`
      <div class="group-card" style="animation-delay:${i*70}ms">
        <h4>Group ${i+1}</h4>
        <ul>${g.map(n=>`<li>${escapeHtml(n)}</li>`).join('') || '<li style="color:var(--chalk-dim)">—</li>'}</ul>
      </div>
    `).join('')
  }</div>`;
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

loadAll();
</script>
</body>
</html>
